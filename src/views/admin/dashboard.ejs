<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <div class="mx-auto max-w-7xl px-4 py-8">
      <header class="mb-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <h1 class="text-3xl font-semibold">Dashboard do Administrador</h1>
          <p class="mt-1 text-sm text-slate-600">Gerencie todas as ocorrências e atualize seus status.</p>
        </div>
        <div class="flex items-center gap-3">
          <button type="button" onclick="history.back()" class="rounded-2xl border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700">Voltar</button>
          <form method="get" class="flex items-center gap-2">
            <select name="categoriaId" class="rounded-2xl border border-slate-300 bg-white px-3 py-2 text-sm">
              <option value="">Todas as categorias</option>
              <% categorias.forEach((categoria) => { %>
                <option value="<%= categoria.idcategoria %>" <%= String(selectedCategoria) === String(categoria.idcategoria) ? 'selected' : '' %>><%= categoria.nomecategoria %></option>
              <% }); %>
            </select>
            <button type="submit" class="rounded-2xl bg-sky-600 px-3 py-2 text-sm font-semibold text-white">Filtrar</button>
          </form>
          <a href="/logout" class="rounded-2xl border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700">Sair</a>
        </div>
      </header>

      <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-slate-200 text-left">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500">Título</th>
              <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500">Categoria</th>
              <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500">Status</th>
              <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500">Usuário</th>
              <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            <% if (!ocorrencias || ocorrencias.length === 0) { %>
              <tr><td colspan="5" class="px-4 py-10 text-center text-sm text-slate-500">Nenhuma ocorrência encontrada.</td></tr>
            <% } else { %>
              <% ocorrencias.forEach((ocorrencia) => { %>
                <tr class="hover:bg-slate-50">
                  <td class="px-4 py-4 text-sm text-slate-700"><%= ocorrencia.titulo %></td>
                  <td class="px-4 py-4 text-sm text-slate-700"><%= ocorrencia.nomecategoria %></td>
                  <td class="px-4 py-4 text-sm text-slate-700"><%= ocorrencia.situacao %></td>
                  <td class="px-4 py-4 text-sm text-slate-700"><%= ocorrencia.usuario_email %></td>
                  <td class="px-4 py-4 text-sm">
                    <div class="flex flex-wrap gap-2">
                      <form action="/admin/ocorrencias/<%= ocorrencia.idocorrencia %>/situacao" method="post" class="inline">
                        <input type="hidden" name="idSituacao" value="5" />
                        <button type="submit" class="rounded-lg bg-amber-500 px-3 py-2 text-white hover:bg-amber-600">Em Andamento</button>
                      </form>
                      <form action="/admin/ocorrencias/<%= ocorrencia.idocorrencia %>/situacao" method="post" class="inline">
                        <input type="hidden" name="idSituacao" value="6" />
                        <button type="submit" class="rounded-lg bg-emerald-600 px-3 py-2 text-white hover:bg-emerald-700">Concluída</button>
                      </form>
                      <form action="/admin/ocorrencias/<%= ocorrencia.idocorrencia %>/excluir" method="post" class="inline" onsubmit="return confirm('Deseja realmente apagar esta ocorrência?');">
                        <button type="submit" class="rounded-lg bg-rose-600 px-3 py-2 text-white hover:bg-rose-700">Apagar</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </body>
</html>
