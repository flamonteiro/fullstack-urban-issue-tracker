<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <div class="mx-auto max-w-3xl px-4 py-10">
      <div class="mb-8 rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
        <div class="mb-6 flex items-center justify-between gap-4">
          <button type="button" onclick="history.back()" class="rounded-xl bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200">Voltar</button>
          <div>
            <h1 class="text-3xl font-semibold"><%= title %></h1>
            <p class="mt-1 text-sm text-slate-600">Preencha os dados da ocorrência.</p>
          </div>
          <a href="/cidadao/ocorrencias" class="rounded-xl bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200">Voltar</a>
        </div>

        <form action="<%= action %>" method="post" class="space-y-6">
          <div class="grid gap-6 sm:grid-cols-2">
            <div class="space-y-2">
              <label for="titulo" class="block text-sm font-medium text-slate-700">Título</label>
              <input id="titulo" name="titulo" type="text" required value="<%= ocorrencia ? ocorrencia.titulo : '' %>" class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-100" />
            </div>
            <div class="space-y-2">
              <label for="idCategoria" class="block text-sm font-medium text-slate-700">Categoria</label>
              <select id="idCategoria" name="idCategoria" required class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-100">
                <option value="" disabled <%= !ocorrencia ? 'selected' : '' %>>Selecione</option>
                <% categorias.forEach((categoria) => { %>
                  <option value="<%= categoria.idcategoria %>" <%= ocorrencia && String(ocorrencia.idcategoria) === String(categoria.idcategoria) ? 'selected' : '' %>><%= categoria.nomecategoria %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="space-y-2">
            <label for="descricao" class="block text-sm font-medium text-slate-700">Descrição</label>
            <textarea id="descricao" name="descricao" rows="5" required class="w-full rounded-3xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-100"><%= ocorrencia ? ocorrencia.descricao : '' %></textarea>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div class="space-y-2">
              <label for="rua" class="block text-sm font-medium text-slate-700">Rua</label>
              <input id="rua" name="rua" type="text" required value="<%= ocorrencia ? ocorrencia.rua : '' %>" class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-100" />
            </div>
            <div class="space-y-2">
              <label for="numero" class="block text-sm font-medium text-slate-700">Número</label>
              <input id="numero" name="numero" type="number" required value="<%= ocorrencia ? ocorrencia.numero : '' %>" class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-100" />
            </div>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div class="space-y-2">
              <label for="bairro" class="block text-sm font-medium text-slate-700">Bairro</label>
              <input id="bairro" name="bairro" type="text" required value="<%= ocorrencia ? ocorrencia.bairro : '' %>" class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-100" />
            </div>
            <div class="space-y-2">
              <label for="cep" class="block text-sm font-medium text-slate-700">CEP</label>
              <input id="cep" name="cep" type="text" required value="<%= ocorrencia ? ocorrencia.cep : '' %>" class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-100" />
            </div>
          </div>

          <div class="space-y-2">
            <label for="referencia" class="block text-sm font-medium text-slate-700">Referência</label>
            <input id="referencia" name="referencia" type="text" value="<%= ocorrencia ? ocorrencia.referencia : '' %>" class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-sky-500 focus:ring-2 focus:ring-sky-100" />
          </div>

          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <a href="/cidadao/ocorrencias" class="inline-flex items-center justify-center rounded-2xl border border-slate-300 px-5 py-3 text-sm font-medium text-slate-700 hover:bg-slate-100">Cancelar</a>
            <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-sky-600 px-5 py-3 text-sm font-semibold text-white shadow hover:bg-sky-700">Salvar</button>
          </div>
        </form>
      </div>
    </div>
  </body>
</html>
